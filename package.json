		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@eslint/js": "9.30.1",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.36.0"
	}
